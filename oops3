Q) Write a code of single level inheritance

Ans)


#include <iostream>
using namespace std;


class Human
{

//propertise
protected:         // with help of protected only child members acces the data of parent class
string name;

};
class Student : public Human
{
int roll_no;

public:
Student(string n, int a)
{
name =n;
roll_no=a;

}

void display()
{
cout<<name<< " "<<roll_no;
}
};
int main ()
{
Student obj("messi", 10);
obj.display();

}

