Ans)
#include <iostream>
using namespace std;

class Student
{
    private: //Abstraction is used
// properties/data  members
string name;                     
int age;         // encapsulation is uesd means string, age and roll_no are all in one place
int roll_no;

public:

void setter ( string n, int a, int r)
{
name=n;
age=a;
roll_no=r;

}

int getter()
{
return age;


}



};
int main ()
{

    Student obj;
    obj.setter("messi",36,10);
    cout<<obj.getter();
    return 0;
}

